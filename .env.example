# Mute Platform — environment secrets & default panel profile
# Copy this file to `.env` and fill in your details.
#
# Note: on first run the Setup Wizard creates .env for you and stores BOT_TOKEN here.
# You only need to edit this file manually if you prefer to pre-seed values before setup.

# --- Telegram (secret) -------------------------------------------------------
# Telegram bot token from @BotFather. Secrets live only in .env, never in JSON.
# Non-secret Telegram settings (enabled, owner_ids) live in config/settings.json.
BOT_TOKEN=

# --- PasarGuard default profile ---------------------------------------------
# Name used for the default profile seeded from this file.
PASARGUARD_PROFILE=default

# Base URL of your PasarGuard panel (no trailing slash).
PASARGUARD_BASE_URL=https://your-panel.example.com

# Preferred auth: admin username + password.
# The client obtains a bearer token automatically and refreshes it when expired.
PASARGUARD_USERNAME=admin
PASARGUARD_PASSWORD=change-me

# Optional: use a pre-generated bearer token instead of username/password.
# If both are set, username/password take precedence for automatic refresh.
PASARGUARD_TOKEN=

# Set to false for panels using self-signed TLS certificates.
PASARGUARD_VERIFY_SSL=true
